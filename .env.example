# Copy to .env.local (local) or set in your host's dashboard (Vercel > Settings > Environment Variables).
# NEVER commit real values. None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).

# Where demo-request leads are forwarded (your CRM / Zapier / Make / n8n webhook URL).
LEAD_WEBHOOK_URL=

# Optional shared secret sent as the "X-Webhook-Secret" header so your webhook can verify the sender.
LEAD_WEBHOOK_SECRET=

# Public canonical URL of the site (used for social preview links), e.g. https://www.sermawebdesign.com
SITE_URL=
