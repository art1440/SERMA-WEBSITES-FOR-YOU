# Copy to .env.local (local) or set in your host's dashboard (Vercel > Settings > Environment Variables).
# NEVER commit real values. Nothing here is exposed to the browser (no NEXT_PUBLIC_ prefix).

# Public canonical URL of the site (used for social preview links), e.g. https://www.sermawebdesign.com
SITE_URL=

# Lead CRM at /admin (Netlify Functions scope). See README → Lead CRM.
CRM_PASSWORD=
CRM_SESSION_SECRET=
NETLIFY_API_TOKEN=
