---
/**
 * A phone screen built from rounded tiles: the still "poster" of the 3D phone.
 * Same layout and proportions the 3D scene uses (src/scenes/layout.ts, src/scenes/hero/pose.ts).
 */
import DeviceGrid from './DeviceGrid.astro';
import { phone } from '../scenes/layout';
interface Props { class?: string; fill?: number }
const { class: className, fill = 1 } = Astro.props;
---
<div class:list={['tile-phone', className]} aria-hidden="true">
  <div class="tp-screen"><DeviceGrid layout={phone} fill={fill} /></div>
</div>
<style>
  .tile-phone {
    position: relative;
    container-type: size;
    aspect-ratio: 9 / 17.5;
    border-radius: 16% / 8.23%;
    background: linear-gradient(0deg, #111A17, #1E2C27);
    border: 1px solid var(--c-line);
    box-shadow: var(--depth-3), inset 0 0 0 1px rgb(255 255 255 / 0.03);
  }
  .tp-screen { position: absolute; inset: 7cqw; }
</style>
