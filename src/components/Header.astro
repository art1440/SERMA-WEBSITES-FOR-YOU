---
import { en } from '../i18n/en';
import { routes } from '../config/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const t = en;
---
<header class="site-header" data-header>
  <div class="container bar">
    <Logo />
    <nav class="nav-desktop" aria-label={t.a11y.mainNav}>
      <ul role="list">
        {t.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="lang" href={routes.spanishHome} hreflang="es" lang="es" aria-label={t.a11y.switchLang}>ES</a>
      <a class="call-link" href={routes.bookCall}>{t.cta.secondary}</a>
      <a class="btn btn-primary header-cta" href={routes.freePreview} data-open-preview>
        <span class="full">{t.cta.primary}</span><span class="short">{t.cta.primaryShort}</span>
      </a>
      <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" data-open-menu>
        <Icon name="menu" />
        <span class="visually-hidden">{t.a11y.menu}</span>
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label={t.a11y.mainNav} data-light-dismiss>
  <div class="mm-inner">
    <div class="mm-top">
      <Logo />
      <button class="menu-btn" type="button" data-close-dialog>
        <Icon name="close" />
        <span class="visually-hidden">{t.a11y.closeMenu}</span>
      </button>
    </div>
    <nav aria-label={t.a11y.mainNav}>
      <ul role="list" class="mm-list">
        {t.nav.map((item) => <li><a href={item.href} data-close-dialog>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="mm-actions">
      <a class="btn btn-primary btn-lg btn-block" href={routes.freePreview} data-open-preview>{t.cta.primary}</a>
      <a class="btn btn-secondary btn-lg btn-block" href={routes.bookCall}>{t.cta.secondary}</a>
      <a class="mm-lang" href={routes.spanishHome} hreflang="es" lang="es">Ver en español</a>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--c-bg) 82%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid transparent;
    transition: transform var(--dur-reveal) var(--ease-out), border-color var(--dur-ui);
  }
  .site-header[data-scrolled] { border-bottom-color: var(--c-line); }
  .site-header[data-hidden] { transform: translateY(-100%); }
  .site-header:focus-within { transform: none; }
  .bar { display: flex; align-items: center; gap: var(--sp-6); height: var(--layout-header-height); }

  .nav-desktop { margin-inline: auto; }
  .nav-desktop ul { display: flex; gap: var(--sp-1); }
  .nav-desktop a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--sp-3);
    text-decoration: none; font-size: var(--fs-small); font-weight: 550; color: var(--c-muted);
    border-radius: var(--r-small); transition: color var(--dur-ui), background-color var(--dur-ui);
  }
  .nav-desktop a:hover { color: var(--c-text); background: var(--c-surface); }

  .actions { display: flex; align-items: center; gap: var(--sp-2); margin-left: auto; }
  .nav-desktop + .actions { margin-left: 0; }
  .lang, .call-link {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 0 var(--sp-3);
    font-size: var(--fs-small); font-weight: 600; text-decoration: none; border-radius: var(--r-small); color: var(--c-muted);
    transition: color var(--dur-ui), background-color var(--dur-ui);
  }
  .lang:hover, .call-link:hover { color: var(--c-text); background: var(--c-surface); }
  .header-cta { min-height: 2.75rem; padding: 0 var(--sp-4); }
  .header-cta .short { display: none; }

  .menu-btn {
    display: none; place-items: center; width: 2.75rem; height: 2.75rem; flex: none;
    border: 1.5px solid var(--c-line); border-radius: var(--r-tile); background: var(--c-surface);
    transition: border-color var(--dur-ui);
  }
  .menu-btn:hover { border-color: var(--c-field); }
  .menu-btn :global(svg) { width: 1.35rem; height: 1.35rem; }

  @media (max-width: 1080px) {
    .nav-desktop, .call-link { display: none; }
    .menu-btn { display: grid; }
    .actions, .nav-desktop + .actions { margin-left: auto; }
  }
  @media (max-width: 640px) {
    .lang { display: none; }
    .header-cta .full { display: none; }
    .header-cta .short { display: inline; }
  }
  @media (max-width: 359px) {
    .header-cta { display: none; }
  }

  /* Mobile menu: full-screen sheet */
  .mobile-menu {
    width: 100%; max-width: 100%; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0;
    background: var(--c-bg); color: var(--c-text);
  }
  .mobile-menu::backdrop { background: rgb(0 0 0 / 0.6); }
  .mm-inner {
    display: flex; flex-direction: column; gap: var(--sp-8); min-height: 100%;
    padding: calc(env(safe-area-inset-top, 0px) + var(--sp-3)) max(var(--sp-gutter), env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + var(--sp-6)) max(var(--sp-gutter), env(safe-area-inset-left, 0px));
  }
  .mm-top { display: flex; align-items: center; justify-content: space-between; min-height: calc(var(--layout-header-height) - var(--sp-3)); }
  .mm-top .menu-btn { display: grid; }
  .mm-list { display: grid; }
  .mm-list a {
    display: flex; align-items: center; min-height: 3.5rem; text-decoration: none;
    font-family: var(--font-display); font-weight: 700; font-size: clamp(1.75rem, 8vw, 2.5rem); letter-spacing: -0.03em;
    border-bottom: 1px solid var(--c-line);
  }
  .mm-actions { display: grid; gap: var(--sp-3); margin-top: auto; }
  .mm-lang { justify-self: center; display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] { animation: sheet-in var(--dur-reveal) var(--ease-out); }
    @keyframes sheet-in { from { opacity: 0; transform: translateY(16px); } }
  }
</style>
