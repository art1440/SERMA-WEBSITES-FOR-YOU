---
import { en } from '../i18n/en';
import { site, routes, industries, isPlaceholder } from '../config/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const t = en.footer;
const year = new Date().getFullYear();
const phoneHref = isPlaceholder(site.phone) ? undefined : `tel:+1${site.phone.replace(/\D/g, '')}`;
const mailHref = isPlaceholder(site.email) ? undefined : `mailto:${site.email}`;
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <Logo />
        <p class="muted">{t.tagline}</p>
      </div>
      <nav class="cols" aria-label={en.a11y.footerNav}>
        <div>
          <h2 class="col-title">{t.company}</h2>
          <ul role="list">
            <li><a href={routes.about}>{t.links.about}</a></li>
            <li><a href={routes.contact}>{t.links.contact}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="col-title">{t.industries}</h2>
          <ul role="list">
            {industries.map((i) => <li><a href={`${routes.industries}/${i.slug}`}>{i.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="col-title">{t.legal}</h2>
          <ul role="list">
            <li><a href={routes.privacy}>{t.links.privacy}</a></li>
            <li><a href={routes.terms}>{t.links.terms}</a></li>
            <li><a href={routes.accessibility}>{t.links.accessibility}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="col-title">{t.contact}</h2>
          <address>
            <ul role="list">
              <li class="ic"><Icon name="pin" /><span>{site.name}<br />{site.city}, {site.region}</span></li>
              <li class="ic"><Icon name="mail" />{mailHref ? <a href={mailHref}>{site.email}</a> : <span class="ph">{site.email}</span>}</li>
              <li class="ic"><Icon name="phone" />{phoneHref ? <a href={phoneHref}>{site.phone}</a> : <span class="ph">{site.phone}</span>}</li>
            </ul>
          </address>
        </div>
      </nav>
    </div>
    <p class="legal">© {year} {site.legalName}. {t.rights}</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--c-line); padding-block: var(--sp-16) var(--sp-8); font-size: var(--fs-small); }
  .top { display: grid; gap: var(--sp-12); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 960px) { .top { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); } }
  .brand { display: grid; gap: var(--sp-4); align-content: start; max-width: 22rem; }
  .cols { display: grid; gap: var(--sp-8) var(--sp-6); grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); }
  .col-title { font-family: var(--font-body); font-size: var(--fs-micro); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-muted); margin-bottom: var(--sp-3); }
  ul { display: grid; gap: 0; }
  a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--c-text); }
  a:hover { text-decoration: underline; }
  address { font-style: normal; }
  .ic { display: grid; grid-template-columns: 1.1rem 1fr; gap: var(--sp-3); align-items: center; min-height: 44px; }
  .ic :global(svg) { width: 1.1rem; height: 1.1rem; color: var(--c-secondary); }
  .ph { color: var(--c-accent); font-family: ui-monospace, Menlo, monospace; font-size: var(--fs-micro); }
  .legal { margin-top: var(--sp-12); padding-top: var(--sp-6); border-top: 1px solid var(--c-line); color: var(--c-muted); }
</style>
