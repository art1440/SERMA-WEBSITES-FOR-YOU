---
import { en } from '../i18n/en';
import Draft from '../components/Draft.astro';
const t = en.faq;
---
<section id="faq" class="section faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="faq-title" class="display display-l">{t.title}</h2>
    </div>
    <div class="items">
      {t.items.map((item) => (
        <details class="item">
          <summary>
            <span class="q">{item.q}</span>
            <span class="icon" aria-hidden="true"></span>
          </summary>
          <div class="a">
            {'draft' in item && item.draft && <Draft label={t.draftTag} />}
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq-grid { display: grid; gap: var(--sp-8); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) { .faq-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } .section-head { position: sticky; top: calc(var(--layout-header-height) + var(--sp-8)); align-self: start; } }
  .items { border-top: 1px solid var(--c-line); }
  .item { border-bottom: 1px solid var(--c-line); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--sp-6);
    min-height: 4rem; padding-block: var(--sp-5); cursor: pointer; list-style: none;
    font-weight: 650; font-size: var(--fs-body-l); line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .q { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .icon { position: relative; flex: none; width: 2.25rem; height: 2.25rem; border-radius: 9px; border: 1.5px solid var(--c-field); transition: background-color var(--dur-ui), border-color var(--dur-ui), transform var(--dur-ui) var(--ease-spring); }
  .icon::before, .icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.85rem; height: 2px; background: currentColor; translate: -50% -50%; border-radius: 1px; transition: transform var(--dur-ui) var(--ease-out); }
  .icon::after { transform: rotate(90deg); }
  details[open] .icon { background: var(--c-accent); border-color: var(--c-accent); color: var(--c-on-accent); transform: rotate(-8deg); }
  details[open] .icon::after { transform: rotate(0deg); }
  .a { display: grid; gap: var(--sp-3); justify-items: start; padding-bottom: var(--sp-6); max-width: 40rem; color: var(--c-muted); }
  @media (prefers-reduced-motion: no-preference) {
    details[open] .a { animation: a-in var(--dur-reveal) var(--ease-out); }
    @keyframes a-in { from { opacity: 0; transform: translateY(-6px); } }
  }
</style>
