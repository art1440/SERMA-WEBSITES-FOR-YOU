---
import { en } from '../i18n/en';
import { routes, site, isPlaceholder } from '../config/site';
import TilePhone from '../components/TilePhone.astro';
import Icon from '../components/Icon.astro';
const t = en.final;
const mailHref = isPlaceholder(site.email) ? undefined : `mailto:${site.email}`;
const phoneHref = isPlaceholder(site.phone) ? undefined : `tel:+1${site.phone.replace(/\D/g, '')}`;
---
<section id="get-started" class="section final" aria-labelledby="final-title" data-final-cta>
  <div class="container final-grid">
    <div class="copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="final-title" class="display display-xl">{t.title}</h2>
      <p class="lead">{t.lead}</p>
      <!-- Phase 4: the tile cloud returns here, half-assembled. -->
      <div class="finale" data-scene="finale" aria-hidden="true">
        <div class="finale-poster">
          <TilePhone class="fp" fill={0.55} />
          <i class="tl tl-open f1"></i><i class="tl tl-booked f2"></i><i class="tl tl-open f3"></i><i class="tl tl-open f4"></i>
        </div>
        <div class="finale-canvas" data-canvas-host></div>
      </div>
    </div>
    <div class="card contact-card">
      <h3 class="h3">{t.contactTitle}</h3>
      <ul class="contact" role="list">
        <li>
          <span class="ic" aria-hidden="true"><Icon name="mail" /></span>
          <span><span class="label">{t.email}</span>{mailHref ? <a href={mailHref}>{site.email}</a> : <span class="ph">{site.email}</span>}</span>
        </li>
        <li>
          <span class="ic" aria-hidden="true"><Icon name="phone" /></span>
          <span><span class="label">{t.phone}</span>{phoneHref ? <a href={phoneHref}>{site.phone}</a> : <span class="ph">{site.phone}</span>}</span>
        </li>
        <li>
          <span class="ic" aria-hidden="true"><Icon name="pin" /></span>
          <span><span class="label">{t.location}</span>{site.city}, {site.region}</span>
        </li>
      </ul>
    </div>
  </div>
</section>
<style>
  .final { background: radial-gradient(70% 50% at 20% 0%, color-mix(in srgb, var(--c-secondary) 7%, transparent), transparent 70%); }
  .final-grid { display: grid; gap: var(--sp-12); grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 1024px) { .final-grid { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); } }
  .copy { display: grid; gap: var(--sp-5); justify-items: start; }
  .talk { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2); color: var(--c-muted); }
  .talk a { color: var(--c-text); text-decoration: none; }
  .contact-card { display: grid; gap: var(--sp-4); border-radius: calc(var(--r-large) * 1.25); box-shadow: var(--depth-3); }
  .contact { display: grid; gap: var(--sp-3); margin-top: var(--sp-2); }
  .contact li { display: grid; grid-template-columns: 3rem 1fr; gap: var(--sp-4); align-items: center; padding: var(--sp-4); border-radius: var(--r-tile); background: var(--c-raised); border: 1px solid var(--c-line); }
  .contact .ic { width: 3rem; height: 3rem; border-radius: var(--r-tile); display: grid; place-items: center; background: var(--c-secondary-dim); color: var(--c-secondary); }
  .contact .ic :global(svg) { width: 1.3rem; height: 1.3rem; }
  .contact .label { display: block; font-size: var(--fs-micro); color: var(--c-muted); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .contact a { font-weight: 650; font-size: var(--fs-body-l); display: inline-flex; min-height: 44px; align-items: center; }
  .ph { color: var(--c-accent); font-family: ui-monospace, Menlo, monospace; }
  .finale { position: relative; width: min(100%, 24rem); aspect-ratio: 1.3; margin-top: var(--sp-6); }
  .finale-poster { position: absolute; inset: 0; transition: opacity 400ms var(--ease-out); }
  .finale-canvas { position: absolute; inset: -12%; opacity: 0; pointer-events: none; transition: opacity 400ms var(--ease-out); }
  .finale-canvas :global(canvas) { display: block; width: 100%; height: 100%; }
  .finale:global(.scene-live) .finale-poster { opacity: 0; }
  .finale:global(.scene-live) .finale-canvas { opacity: 1; }
  .finale :global(.fp) { position: absolute; left: 22%; top: 0; width: 38%; transform: rotate(-6deg); }
  .finale .tl { position: absolute; width: 11%; aspect-ratio: 1; border-radius: 22%; }
  .f1 { left: 4%; top: 30%; transform: rotate(-12deg); } .f2 { left: 70%; top: 18%; transform: rotate(14deg); width: 14%; }
  .f3 { left: 78%; top: 58%; transform: rotate(-6deg); } .f4 { left: 8%; top: 72%; transform: rotate(20deg); width: 8%; }
  @media (max-width: 1023px) { .finale { display: none; } }
</style>
