---
import { en } from '../i18n/en';
import { routes } from '../config/site';
import Icon from '../components/Icon.astro';
const t = en.work;
/**
 * Real client sites only. Add one like:
 *   { name: 'Shop Name', industry: 'Barbershop', url: 'https://…', image: '/work/shop.avif', device: 'laptop' }
 * The screenshot should be 1440 x 900 (laptop) or 780 x 1500 (phone), AVIF or WebP.
 */
const clients: { name: string; industry: string; url: string; image: string; device: 'laptop' | 'phone' }[] = [];
const placeholderDevices: ('laptop' | 'phone')[] = ['laptop', 'phone', 'laptop'];
const placeholders = placeholderDevices.slice(0, Math.max(0, 3 - clients.length));
---
<section id="work" class="section work" aria-labelledby="work-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="work-title" class="display display-l">{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>
    <ul class="grid" role="list">
      {clients.map((c, i) => (
        <li class="slot" data-reveal style={`--i:${i}`}>
          <a class="slot-link" href={c.url} target="_blank" rel="noopener">
            <div class="stage3d">
              <div class:list={['device', `is-${c.device}`]} data-tilt>
                <div class="screen"><img src={c.image} alt="" loading="lazy" decoding="async" /></div>
                <i class="glare" aria-hidden="true"></i>
              </div>
            </div>
            <div class="meta">
              <span class="tag">{c.industry}</span>
              <p class="h3">{c.name} <Icon name="external" /><span class="visually-hidden"> {en.a11y.newTab}</span></p>
            </div>
          </a>
        </li>
      ))}
      {placeholders.map((device, i) => (
        <li class="slot" data-reveal style={`--i:${clients.length + i}`}>
          <div class="stage3d" aria-hidden="true">
            <div class:list={['device', `is-${device}`, 'is-placeholder']} data-tilt>
              <div class="screen">
                <div class="ph-grid">
                  <i class="tl tl-open"></i><i class="tl tl-open"></i><i class="tl tl-open wide"></i><i class="tl tl-open"></i><i class="tl tl-open"></i>
                </div>
              </div>
              <i class="glare"></i>
            </div>
          </div>
          <div class="meta">
            <span class="draft-tag">{t.placeholderTag}</span>
            <p class="h3">{t.placeholder}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="more">
      <a class="link-arrow" href={routes.freePreview} data-open-preview>{t.cta}<Icon name="arrow-right" /></a>
    </p>
  </div>
</section>

<script>
  // Devices tilt toward the pointer, with a soft glare. Desktop only; off with reduced motion.
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !calm) {
    document.querySelectorAll<HTMLElement>('.work [data-tilt]').forEach((el) => {
      const area = el.closest<HTMLElement>('.slot') ?? el;
      area.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
        const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
        el.style.setProperty('--ry', `${(x - 0.5) * 16}deg`);
        el.style.setProperty('--rx', `${(0.5 - y) * 11}deg`);
        el.style.setProperty('--gx', `${x * 100}%`);
        el.style.setProperty('--gy', `${y * 100}%`);
        el.dataset.active = '';
      });
      area.addEventListener('pointerleave', () => {
        el.style.removeProperty('--rx');
        el.style.removeProperty('--ry');
        delete el.dataset.active;
      });
    });
  }
</script>

<style>
  .grid { display: grid; gap: var(--sp-8) var(--sp-6); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .slot { display: grid; gap: var(--sp-5); align-content: start; }
  .slot-link { display: grid; gap: var(--sp-5); text-decoration: none; border-radius: var(--r-large); }
  .slot-link .h3 { display: inline-flex; align-items: center; gap: var(--sp-2); }
  .slot-link .h3 :global(svg) { width: 1rem; height: 1rem; color: var(--c-muted); }

  .stage3d { perspective: 900px; aspect-ratio: 4 / 3; display: grid; place-items: center; }
  .device {
    --rx: 0deg; --ry: 0deg;
    position: relative; transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform var(--dur-reveal) var(--ease-out);
  }
  .device[data-active] { transition-duration: 120ms; }
  .slot-link:focus-visible .device, .slot-link:hover .device { --rx: 4deg; --ry: -8deg; }
  .slot-link:focus-visible { outline-offset: 6px; }

  .is-laptop { width: 92%; }
  .is-laptop .screen { aspect-ratio: 16 / 10; border-radius: 12px 12px 4px 4px; padding: 3.5%; }
  /* Keyboard base, tilted toward the viewer. */
  .is-laptop::after {
    content: ''; position: absolute; left: -6%; right: -6%; top: 100%; height: 12%;
    background: linear-gradient(#24342E, #121B17); border-radius: 0 0 14px 14px;
    transform-origin: top; transform: rotateX(62deg);
    box-shadow: 0 24px 40px -18px rgb(0 0 0 / 0.8);
  }
  .is-phone { width: 34%; }
  .is-phone .screen { aspect-ratio: 9 / 18; border-radius: 22px; padding: 7%; }

  .screen {
    position: relative; overflow: hidden;
    background: linear-gradient(160deg, #1E2C27, #111A17); border: 1px solid var(--c-line);
    box-shadow: var(--depth-3), inset 0 0 0 1px rgb(255 255 255 / 0.03);
  }
  .screen img { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 6px; display: block; }
  .is-placeholder .screen { border-style: dashed; border-color: color-mix(in srgb, var(--c-secondary) 40%, transparent); }
  .ph-grid { width: 100%; height: 100%; display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: 0.4fr 1.4fr 0.5fr; gap: 6%; }
  .is-phone .ph-grid { grid-template-columns: repeat(2, 1fr); grid-template-rows: 0.3fr 1.2fr 0.5fr 0.5fr; }
  .ph-grid .tl { border-radius: 6px; }
  .ph-grid .wide { grid-column: 1 / -1; }
  .glare {
    position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: 0;
    background: radial-gradient(60% 60% at var(--gx, 50%) var(--gy, 0%), rgb(255 255 255 / 0.12), transparent 70%);
    transition: opacity var(--dur-ui);
  }
  .device[data-active] .glare { opacity: 1; }

  .meta { display: grid; gap: var(--sp-2); justify-items: start; }
  .is-placeholder ~ .meta .h3, .slot > .meta .h3 { color: var(--c-muted); }
  .more { margin-top: var(--sp-8); }
  .more a { color: var(--c-accent); text-decoration: none; }
  @media (prefers-reduced-motion: reduce) { .device { transition: none; } .slot-link:hover .device { --rx: 0deg; --ry: 0deg; } }
</style>
