---
import { en } from '../i18n/en';
import { routes } from '../config/site';
import Icon from '../components/Icon.astro';
import TilePhone from '../components/TilePhone.astro';
const t = en.hero;
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 id="hero-title" class="display display-xl">{t.title}</h1>
      <p class="lead">{t.lead}</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href={routes.freePreview} data-open-preview>{en.cta.primary}<Icon name="arrow-right" /></a>
        <a class="btn btn-secondary btn-lg" href={routes.bookCall}><Icon name="calendar" />{en.cta.secondary}</a>
      </div>
      <ul class="trust" role="list">
        {t.trust.map((item) => <li><Icon name="check" />{item}</li>)}
      </ul>
    </div>

    <!-- Decorative stage. Phase 3 renders the 3D scene here; this composition stays as the fallback. -->
    <div class="stage" data-scene="hero" aria-hidden="true">
      <div class="poster">
        <div class="browser">
          <div class="b-top"><i></i><span>yourshop.com</span></div>
          <div class="b-body">
            <i class="tl tl-mint b-logo"></i><i class="tl b-nav"></i>
            <i class="tl tl-photo b-hero"></i>
            <i class="tl tl-text b-h"></i><i class="tl tl-muted b-p"></i>
            <i class="tl tl-booked b-cta"></i>
            <i class="tl b-s"></i><i class="tl b-s"></i><i class="tl tl-open b-s"></i>
          </div>
        </div>
        <TilePhone class="phone" />
        <div class="chip">
          <i class="tl tl-booked"></i>
          <span><b>Booked · Sat 10:30</b><small>Fade + beard · demo</small></span>
        </div>
        <i class="loose l1 tl tl-open"></i><i class="loose l2 tl tl-open"></i><i class="loose l3 tl tl-booked"></i>
        <i class="loose l4 tl tl-open"></i><i class="loose l5 tl"></i>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(var(--sp-8), 5vw, var(--sp-16)) var(--sp-section); overflow: clip; }
  .hero-grid { display: grid; gap: var(--sp-12); grid-template-columns: minmax(0, 1fr); align-items: center; }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--sp-8); }
  }
  .copy { display: grid; gap: var(--sp-6); justify-items: start; min-width: 0; }
  .copy h1 { max-width: 12ch; }
  .copy .lead { max-width: 36rem; }
  .btn-row { margin-top: var(--sp-2); }
  .trust { display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-6); font-size: var(--fs-small); color: var(--c-muted); }
  .trust li { display: inline-flex; align-items: center; gap: var(--sp-2); }
  .trust :global(svg) { width: 1.05rem; height: 1.05rem; color: var(--c-secondary); stroke-width: 2.6; }

  /* Poster composition */
  .stage { position: relative; width: 100%; max-width: 34rem; justify-self: center; }
  .poster { position: relative; aspect-ratio: 1 / 1.02; perspective: 1400px; }
  .browser {
    position: absolute; left: 0; top: 8%; width: 78%; aspect-ratio: 4 / 3;
    border-radius: var(--r-large); background: var(--c-surface); border: 1px solid var(--c-line);
    box-shadow: var(--depth-2); overflow: hidden;
    transform: rotateY(16deg) rotateX(4deg) translateZ(-60px); transform-origin: left center;
  }
  .b-top { display: flex; align-items: center; gap: var(--sp-2); height: 12%; padding-inline: 4%; border-bottom: 1px solid var(--c-line); }
  .b-top i { width: 7%; height: 38%; border-radius: 4px; background: var(--c-raised); }
  .b-top span { flex: 1; max-width: 55%; margin-inline: auto; height: 46%; border-radius: 999px; background: var(--c-bg); color: var(--c-muted); font-size: clamp(0.5rem, 1.1vw, 0.7rem); display: grid; place-items: center; }
  .b-body { display: grid; grid-template-columns: repeat(6, 1fr); grid-template-rows: 0.5fr 2.1fr 0.35fr 0.3fr 0.6fr 1fr; gap: 3.2%; padding: 4.5%; height: 88%; }
  .b-body .tl { border-radius: 5px; }
  .b-logo { grid-column: 1 / 2; } .b-nav { grid-column: 4 / 7; opacity: 0.6; }
  .b-hero { grid-column: 1 / 7; }
  .b-h { grid-column: 1 / 5; } .b-p { grid-column: 1 / 4; opacity: 0.7; }
  .b-cta { grid-column: 1 / 3; }
  .b-s { grid-column: span 2; }

  .poster :global(.phone) {
    position: absolute; right: 2%; bottom: 0; width: 42%;
    transform: rotateY(-14deg) rotateX(6deg) rotateZ(2deg);
  }
  .chip {
    position: absolute; right: 30%; bottom: 14%; display: flex; gap: var(--sp-3); align-items: center;
    padding: var(--sp-3) var(--sp-4) var(--sp-3) var(--sp-3);
    background: var(--c-raised); border: 1px solid var(--c-line); border-radius: var(--r-tile); box-shadow: var(--depth-3);
    font-size: clamp(0.72rem, 1.4vw, 0.875rem); line-height: 1.25; white-space: nowrap;
  }
  .chip .tl { width: 1.6em; height: 1.6em; border-radius: 6px; flex: none; }
  .chip b { display: block; font-weight: 650; }
  .chip small { color: var(--c-muted); font-size: 0.85em; }
  .loose { position: absolute; width: 5.5%; aspect-ratio: 1; border-radius: 22%; }
  .l1 { left: 6%; top: 0; transform: rotate(-14deg); }
  .l2 { left: 82%; top: 4%; transform: rotate(18deg); width: 4%; }
  .l3 { left: 90%; top: 30%; transform: rotate(-10deg); width: 6.5%; }
  .l4 { left: 2%; bottom: 10%; transform: rotate(24deg); width: 4.5%; }
  .l5 { left: 52%; top: 2%; transform: rotate(8deg); width: 3.5%; }
  @media (prefers-reduced-motion: no-preference) {
    .loose { animation: drift 7s var(--ease-in-out) infinite alternate; }
    .l2 { animation-delay: -2s; } .l3 { animation-delay: -4s; } .l4 { animation-delay: -1s; } .l5 { animation-delay: -3s; }
    @keyframes drift { to { translate: 0 -10px; rotate: 10deg; } }
  }
</style>
