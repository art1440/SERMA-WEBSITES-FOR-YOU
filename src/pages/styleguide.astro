---
/** Living style guide: every token and every interactive state in one place. Not indexed. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Draft from '../components/Draft.astro';
import { color, text, motion, radius } from '../design/tokens';

const L = (h: string) => {
  const c = [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0]! + 0.7152 * c[1]! + 0.0722 * c[2]!;
};
const ratio = (a: string, b: string) => {
  const [x, y] = [L(a), L(b)].sort((p, q) => q - p);
  return ((x! + 0.05) / (y! + 0.05)).toFixed(1);
};
const swatches: [keyof typeof color, string][] = [
  ['bg', 'Base'], ['surface', 'Surface'], ['raised', 'Raised'], ['line', 'Divider'], ['field', 'Input border'],
  ['text', 'Text'], ['muted', 'Muted text'], ['accent', 'Marigold (booked, primary)'], ['secondary', 'Mint (open, focus)'],
  ['secondaryDim', 'Mint fill'], ['error', 'Error'], ['paper', 'Paper'], ['ink', 'Ink'], ['inkMuted', 'Ink muted'],
];
const pairs: [string, string, string, string][] = [
  ['Text on base', color.text, color.bg, 'AA 4.5'],
  ['Muted on surface', color.muted, color.surface, 'AA 4.5'],
  ['Marigold on base', color.accent, color.bg, 'AA 4.5'],
  ['Button text on marigold', color.onAccent, color.accent, 'AA 4.5'],
  ['Mint focus on base', color.secondary, color.bg, 'UI 3.0'],
  ['Input border on raised', color.field, color.raised, 'UI 3.0'],
  ['Error on surface', color.error, color.surface, 'AA 4.5'],
  ['Ink on paper', color.ink, color.paper, 'AA 4.5'],
  ['Ink muted on paper', color.inkMuted, color.paper, 'AA 4.5'],
];
const scale = Object.entries(text) as [keyof typeof text, string][];
---
<Base title="Style guide | Serma" description="Design tokens and component states." noindex>
  <div class="container sg">
    <header class="sg-head">
      <p class="eyebrow">Design system</p>
      <h1 class="display display-l">Style guide</h1>
      <p class="lead">Tokens live in <code>src/design/tokens.ts</code>. CSS, scripts, and (from Phase 3) the 3D scenes all read from that one file.</p>
    </header>

    <section aria-labelledby="sg-color">
      <h2 id="sg-color" class="display display-m">Color</h2>
      <ul class="swatches" role="list">
        {swatches.map(([key, label]) => (
          <li><span class="chip" style={`background:${color[key]}`}></span><b>{label}</b><code>{key} · {color[key]}</code></li>
        ))}
      </ul>
      <h3 class="h3">Contrast checks</h3>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Contrast checks">
        <table>
          <thead><tr><th>Pair</th><th>Sample</th><th>Ratio</th><th>Needs</th></tr></thead>
          <tbody>
            {pairs.map(([name, fg, bg, need]) => (
              <tr><td>{name}</td><td>{need.startsWith('UI') ? <span class="sample ui" style={`border-color:${fg};background:${bg}`} aria-hidden="true"></span> : <span class="sample" style={`color:${fg};background:${bg}`}>Book now</span>}</td><td>{ratio(fg, bg)}:1</td><td>{need}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="sg-type">
      <h2 id="sg-type" class="display display-m">Type</h2>
      <p class="muted">Display: Bricolage Grotesque, 96 pt optical size, 600–800. Body: Geist. Both SIL Open Font License.</p>
      <ul class="scale" role="list">
        {scale.map(([key, value]) => (
          <li>
            <code>{key}</code>
            <span class:list={[key.startsWith('display') || key === 'h3' ? 'display' : '']} style={`font-size:${value}`}>{key.startsWith('display') ? 'Get booked.' : 'Customers pick a time and they\'re booked. ¿Listo?'}</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="sg-buttons">
      <h2 id="sg-buttons" class="display display-m">Buttons</h2>
      <p class="muted">Hover, press, and tab through these to see each state.</p>
      <div class="row">
        <button class="btn btn-primary btn-lg" type="button">Primary<Icon name="arrow-right" /></button>
        <button class="btn btn-primary" type="button">Primary</button>
        <button class="btn btn-primary" type="button" data-loading aria-disabled="true"><span>Loading</span></button>
        <button class="btn btn-primary" type="button" disabled>Disabled</button>
      </div>
      <div class="row">
        <button class="btn btn-secondary btn-lg" type="button"><Icon name="calendar" />Secondary</button>
        <button class="btn btn-secondary" type="button">Secondary</button>
        <button class="btn btn-secondary" type="button" data-loading aria-disabled="true"><span>Loading</span></button>
        <a class="link-arrow" href="#sg-buttons">Text link<Icon name="arrow-right" /></a>
      </div>
      <div class="row on-paper paper-box">
        <button class="btn btn-ink btn-lg" type="button">Ink button on paper</button>
        <Draft />
      </div>
    </section>

    <section aria-labelledby="sg-forms">
      <h2 id="sg-forms" class="display display-m">Form fields</h2>
      <div class="forms">
        <div class="field">
          <label class="field-label" for="sg-a">Default</label>
          <input class="input" id="sg-a" type="text" placeholder="Placeholder text" />
        </div>
        <div class="field">
          <label class="field-label" for="sg-b">With error</label>
          <input class="input" id="sg-b" type="text" value="jordan@" aria-invalid="true" aria-describedby="sg-b-err" />
          <p class="field-error" id="sg-b-err">Enter an email address, like name@example.com.</p>
        </div>
        <div class="field">
          <label class="field-label" for="sg-c">Select</label>
          <select class="input" id="sg-c"><option>Barbershop</option><option>Nail salon</option></select>
        </div>
        <fieldset class="field" style="border:0;padding:0">
          <legend class="field-label">Choice group</legend>
          <div class="choice-group">
            <label class="choice"><input type="radio" name="sg-r" checked /><span>English</span></label>
            <label class="choice"><input type="radio" name="sg-r" /><span>Español</span></label>
          </div>
        </fieldset>
      </div>
    </section>

    <section aria-labelledby="sg-tiles">
      <h2 id="sg-tiles" class="display display-m">Tiles</h2>
      <p class="muted">One shape for everything. Mint outline = open slot. Marigold = booked. Radius: {radius.tile}.</p>
      <div class="tiles" aria-hidden="true">
        <i class="tl tl-open"></i><i class="tl tl-booked"></i><i class="tl tl-mint"></i><i class="tl"></i><i class="tl tl-photo"></i><i class="tl tl-photo-2"></i><i class="tl tl-text"></i>
      </div>
    </section>

    <section aria-labelledby="sg-motion">
      <h2 id="sg-motion" class="display display-m">Motion</h2>
      <p class="muted">Durations: press {motion.duration.press}ms · UI {motion.duration.ui}ms · reveal {motion.duration.reveal}ms · chapter {motion.duration.chapter}ms. Reduced motion turns all of it off.</p>
      <div class="motion" data-motion>
        {(['out', 'inOut', 'spring'] as const).map((e) => (
          <div class="track"><code>{e}</code><i class="tl tl-booked dot" style={`transition-timing-function:var(--ease-${e === 'inOut' ? 'in-out' : e})`}></i></div>
        ))}
        <button class="btn btn-secondary" type="button" data-play>Play easing</button>
      </div>
    </section>
  </div>
  <script>
    const m = document.querySelector('[data-motion]');
    m?.querySelector('[data-play]')?.addEventListener('click', () => m.classList.toggle('go'));
  </script>
</Base>
<style>
  .sg { display: grid; gap: var(--sp-20); padding-block: var(--sp-12) var(--sp-section); }
  .sg-head { display: grid; gap: var(--sp-4); }
  section { display: grid; gap: var(--sp-6); }
  code { font-family: ui-monospace, Menlo, monospace; font-size: var(--fs-micro); color: var(--c-muted); }
  .swatches { display: grid; gap: var(--sp-4); grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); }
  .swatches li { display: grid; gap: var(--sp-1); font-size: var(--fs-small); }
  .chip { height: 4.5rem; border-radius: var(--r-tile); border: 1px solid var(--c-line); margin-bottom: var(--sp-2); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--c-line); border-radius: var(--r-tile); }
  table { width: 100%; border-collapse: collapse; font-size: var(--fs-small); font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: var(--sp-3) var(--sp-4); border-bottom: 1px solid var(--c-line); white-space: nowrap; }
  th { color: var(--c-muted); font-weight: 600; }
  .sample { display: inline-block; padding: 0.3rem 0.7rem; border-radius: 8px; font-weight: 650; }
  .sample.ui { width: 5.5rem; height: 2rem; border: 2px solid; }
  .scale { display: grid; gap: var(--sp-4); }
  .scale li { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: var(--sp-4); align-items: baseline; border-bottom: 1px solid var(--c-line); padding-bottom: var(--sp-4); overflow: hidden; }
  .row { display: flex; flex-wrap: wrap; gap: var(--sp-4); align-items: center; }
  .paper-box { padding: var(--sp-6); border-radius: var(--r-large); }
  .forms { display: grid; gap: var(--sp-6); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .tiles { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .tiles .tl { width: 4rem; height: 4rem; border-radius: var(--r-tile); }
  .motion { display: grid; gap: var(--sp-3); justify-items: start; }
  .track { position: relative; width: 100%; height: 3rem; border-radius: var(--r-tile); background: var(--c-surface); border: 1px solid var(--c-line); }
  .track code { position: absolute; left: var(--sp-3); top: 50%; translate: 0 -50%; }
  .dot { position: absolute; left: 6rem; top: 0.5rem; width: 2rem; height: 2rem; border-radius: 8px; transition: left var(--dur-chapter); }
  .go .dot { left: calc(100% - 2.5rem); }
</style>
